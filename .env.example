# AI Studio 配置（macOS）。复制成 .env 后按需修改；不写的项按仓库目录结构取默认值。

# 网页服务监听地址和端口（只想本机访问就改成 127.0.0.1）
AI_STUDIO_HOST=0.0.0.0
AI_STUDIO_PORT=8001

# ComfyUI：地址、安装目录、启动参数
AI_STUDIO_COMFY_URL=http://127.0.0.1:8188
# COMFYUI_DIR=$HOME/ai-studio/ComfyUI
# COMFYUI_LOG=$HOME/ai-studio/ComfyUI/user/ai-studio-comfyui.log
# 64 GB 统一内存跑 H3（主模型 14 GB + 文本编码器 14.5 GB + VAE）：给系统留出余量，每步用完就释放
COMFYUI_ARGS="--reserve-vram 10 --cache-none --disable-smart-memory"
# ComfyUI-AppleSilicon-FP8 的 int8 Metal 矩阵乘内核（首次启动会编译，需要 Xcode 命令行工具）
ASFP8_INT8_EXT=1
PYTORCH_ENABLE_MPS_FALLBACK=1

# 数据目录：任务记录、翻译缓存；素材库：成片、缩略图、配音
# AI_STUDIO_DATA=$HOME/ai-studio/data
# AI_STUDIO_LIBRARY=$HOME/Movies/AI-Studio

# 可选功能的路径（scripts/install.sh 默认装在仓库里）
# INDEXTTS_DIR=$HOME/ai-studio/vendor/index-tts
# INDEXTTS_MODEL_DIR=$HOME/ai-studio/models/IndexTTS-2.5
# AI_STUDIO_TOOLS_PYTHON=$HOME/ai-studio/.venvs/tools/bin/python
# AI_STUDIO_SEPARATOR=$HOME/ai-studio/.venvs/tools/bin/audio-separator
# AI_STUDIO_SEPARATOR_MODELS=$HOME/ai-studio/models/separator
# FFMPEG=/opt/homebrew/bin/ffmpeg

# 字体：默认用系统宋体（Songti）和「隶变」（字体册里下载），也可以指定字体文件
# AI_STUDIO_FONT_SONG=
# AI_STUDIO_FONT_SONG_BOLD=
# AI_STUDIO_FONT_LISHU=

# 提示词「中文对照」用本机 Ollama 翻译（可选；brew install ollama）
# OLLAMA_URL=http://127.0.0.1:11434
# AI_STUDIO_TRANSLATE_MODEL=qwen3:8b

# 模型下载：国内网络可用镜像；HF_TOKEN 只在需要登录的仓库才用
# HF_ENDPOINT=https://hf-mirror.com
# HF_TOKEN=
